# Starts without any API key in evidence-only mode.
LLM_PROVIDER=none
# Set LLM_PROVIDER=groq for generated explanations. Keys stay on the server.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# For an alternative OpenAI-compatible host, set LLM_PROVIDER=compatible.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

DATA_DIR=./data
DEMO_MODE=true
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLgUwDviBIf0oF6QL8m22w1hIDC1vJ_BHz
RETRIEVAL_BACKEND=bm25
# For hybrid search: pip install -e '.[semantic]', then a2z index --semantic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MIN_SCORE=0.40
LEXICAL_MIN_COVERAGE=0.35
TOP_K=6
CHUNK_SECONDS=75
CHUNK_OVERLAP=15
LINK_REWIND=4
# Optional managed vector store; hybrid backend required.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=a2z_dsa
# Shared rate limiting is optional; SQLite limiter supports same-host workers.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
# Optional shared access key when exposing a self-hosted server publicly.
APP_API_KEY=
# comma-separated exact frontend origins; same-origin UI needs no CORS
CORS_ORIGINS=
# Offline captions first. Whisper runs only when explicitly requested.
CAPTION_LANGUAGES=en,hi
# If your machine uses a trusted corporate/system CA, opt into its trust store.
# Requests also accepts REQUESTS_CA_BUNDLE=/path/to/trusted-ca-bundle.pem.
# Certificate verification always stays enabled.
YOUTUBE_USE_SYSTEM_CA=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
PORT=8000
# Optional private HTTPS index artifact for ephemeral cloud hosting.
INDEX_DOWNLOAD_URL=
INDEX_SHA256=
